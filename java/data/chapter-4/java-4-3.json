{
  "id": "java-4-3",
  "title": {
    "zh": "前 N 個奇數（遞增）",
    "en": "First N odd, ascending"
  },
  "description": {
    "zh": "<p>讀入 n，由小到大輸出前 n 個奇數，每個一行（1, 3, 5, …）。</p>",
    "en": "<p>First N odd, ascending.</p>"
  },
  "hint": {
    "zh": "步長 2：<code>for (int i = 1; i &lt;= 2*n - 1; i += 2)</code>",
    "en": "Step by 2 starting at 1."
  },
  "starterCode": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n    }\n}",
  "tests": [
