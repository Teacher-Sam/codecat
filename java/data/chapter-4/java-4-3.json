      "input": "5",
      "output": "1\n3\n5"
    },
    {
      "input": "3",
      "output": "1\n3"
    },
    {
      "input": "1",
      "output": "1"
    },
    {
      "input": "2",
      "output": "1"
    },
    {
      "input": "4",
      "output": "1\n3"
    },
    {
      "input": "9",
      "output": "1\n3\n5\n7\n9"
