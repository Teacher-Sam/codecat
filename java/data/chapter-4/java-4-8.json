{
  "id": "java-4-8",
  "title": {
    "zh": "N 個數之積",
    "en": "Product of N numbers"
  },
  "description": {
    "zh": "<p>第一行為 N，接著 N 個整數。輸出它們的乘積。</p>",
    "en": "<p>Product of N numbers.</p>"
  },
  "hint": {
    "zh": "累乘初值設 1。",
    "en": "Multiply in a loop; start from 1."
  },
  "starterCode": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n    }\n}",
  "tests": [
    {
      "input": "3\n2\n3\n10",
      "output": "60"
    },
    {
      "input": "5\n4\n2\n1\n10\n-5",
      "output": "-400"
    },
    {
      "input": "5\n4\n2\n0\n10\n-5",
      "output": "0"
    },
    {
      "input": "7\n1\n-1\n1\n-1\n10\n3\n10",
      "output": "300"
    },
    {
      "input": "1\n4",
      "output": "4"
    },
    {
      "input": "1\n0",
      "output": "0"
    },
    {
      "input": "1\n1",
      "output": "1"
    },
    {
      "input": "4\n1\n2\n3\n4",
      "output": "24"
    },
    {
      "input": "6\n3\n5\n7\n9\n11\n13",
      "output": "135135"
    }
  ],
  "source": "snakify.org/en/lessons/for_loop_range/problems/product_of_n_numbers/"
