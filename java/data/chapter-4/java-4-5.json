{
  "id": "java-4-5",
  "title": {
    "zh": "前 N 個偶數（遞減）",
    "en": "First N even, descending"
  },
  "description": {
    "zh": "<p>讀入 n，由大到小輸出前 n 個偶數，每個一行（2n, 2n−2, …, 2）。</p>",
    "en": "<p>First N even, descending.</p>"
  },
  "hint": {
    "zh": "從 <code>2*n</code> 往下，步長 −2。",
    "en": "Start at 2n, step −2."
  },
  "starterCode": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n    }\n}",
  "tests": [
    {
      "input": "9",
      "output": "8\n6\n4\n2\n0"
    },
    {
      "input": "8",
      "output": "8\n6\n4\n2\n0"
    },
    {
      "input": "1",
      "output": "0"
    },
    {
      "input": "2",
      "output": "2\n0"
    },
    {
      "input": "4",
      "output": "4\n2\n0"
    },
    {
      "input": "11",
      "output": "10\n8\n6\n4\n2\n0"
    },
    {
      "input": "7",
      "output": "6\n4\n2\n0"
    },
    {
      "input": "12",
      "output": "12\n10\n8\n6\n4\n2\n0"
    }
  ],
  "source": "snakify.org/en/lessons/for_loop_range/problems/first_n_even_descending/"
