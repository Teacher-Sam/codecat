{
  "id": "cpp-3-6",
  "title": {
    "zh": "兩數皆奇",
    "en": "Are both odd"
  },
  "description": {
    "zh": "<p>讀入兩個整數，若兩者都是奇數輸出 YES，否則 NO。</p>",
    "en": "<p>Are both odd.</p>"
  },
  "hint": {
    "zh": "<code>a % 2 != 0 &amp;&amp; b % 2 != 0</code>",
    "en": "Both odd with <code>&amp;&amp;</code>."
  },
  "starterCode": "#include <iostream>\nusing namespace std;\n\nint main() {\n    \n    return 0;\n}\n",
  "tests": [
    {
      "input": "1\n3",
      "output": "YES"
    },
    {
      "input": "1\n2",
      "output": "NO"
    },
    {
      "input": "5\n3",
      "output": "YES"
    },
    {
      "input": "10\n11",
      "output": "NO"
    },
    {
      "input": "79\n81",
      "output": "YES"
    },
    {
      "input": "79\n100",
      "output": "NO"
    },
    {
      "input": "17\n-5",
      "output": "YES"
    },
    {
      "input": "100\n200",
      "output": "NO"
    },
    {
      "input": "40\n20",
      "output": "NO"
    }
  ],
  "source": "snakify.org/en/lessons/if_then_else_conditions/problems/are_both_odd/"
